; start_gcode = M140 S0 ; needed so prusaslicer/superslicer doesn't add unneeded "wait for temps" by itself\nM104 S0 ; needed so prusaslicer/superslicer doesn't add unneeded "wait for temps" by itself\n\nSTART_PRINT EXTRUDER_TEMP=[first_layer_temperature] BED_TEMP=[first_layer_bed_temperature] MATERIAL=[filament_type] {if filament_type[current_extruder]=~/.*PLA*/}CHAMBER=20{elsif filament_type[current_extruder]=~/.*ABS*/}CHAMBER=30{elsif filament_type[current_extruder] =~/.*PETG*/}CHAMBER=30{elsif filament_type[current_extruder] =~/.*PC*/}CHAMBER=40{endif} {if filament_type[current_extruder]=~/.*PLA*/}SOAK=10 {elsif filament_type[current_extruder]=~/.*ABS*/}SOAK=10{elsif filament_type[current_extruder] =~/.*PETG*/}SOAK=30{elsif filament_type[current_extruder] =~/.*PC*/}SOAK=40{endif} SIZE={first_layer_print_min[0]}_{first_layer_print_min[1]}_{first_layer_print_max[0]}_{first_layer_print_max[1]} TOOL={initial_tool}\n;CHECK_QGL ; will detach probe and cancel print in case of an failing QGL\n_LAYER TOTAL=[total_layer_count] RESPOND=0\nTOGGLE_LAYER_OUTPUT
