; start_gcode = ; M190 S0\n; M109 S0 ; uncomment to remove set&wait temp gcode added automatically after this start gcode\n; print_start EXTRUDER=[first_layer_temperature[initial_tool]] BED=[first_layer_bed_temperature]\n\nM140 S0 ; needed so prusaslicer/superslicer doesn't add unneeded "wait for temps" by itself\nM104 S0 ; needed so prusaslicer/superslicer doesn't add unneeded "wait for temps" by itself\nSTART_PRINT EXTRUDER_TEMP=[first_layer_temperature] BED_TEMP=[first_layer_bed_temperature] LAYER_HEIGHT=[layer_height] {if filament_type[current_extruder]=~/.*PLA*/}CHAMBER=20{elsif filament_type[current_extruder]=~/.*ABS*/}CHAMBER=40{elsif filament_type[current_extruder] =~/.*PETG*/}CHAMBER=30{elsif filament_type[current_extruder] =~/.*PC*/}CHAMBER=40{endif} {if filament_type[current_extruder]=~/.*PLA*/}SOAK=10 {elsif filament_type[current_extruder]=~/.*ABS*/}SOAK=0{elsif filament_type[current_extruder] =~/.*PETG*/}SOAK=30{elsif filament_type[current_extruder] =~/.*PC*/}SOAK=40{endif} MATERIAL=[filament_type] FILAMENT_VENDOR='[filament_vendor]'\n;CHECK_QGL ; will detach probe and cancel print in case of an failing QGL\nTOTAL_LAYER=[total_layer_count] RESPOND=0
